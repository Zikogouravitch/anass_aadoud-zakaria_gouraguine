# Copier ce fichier en .env puis remplir les valeurs. Ne jamais pousser .env.
# Clé demandée par l'API dans l'en-tête X-API-Key (vide = API ouverte en local)
API_KEY=
# Adresse de l'API utilisée par l'interface Streamlit
API_URL=http://localhost:8000
# Seuil de confiance sous lequel l'agent s'abstient (INDETERMINE)
SEUIL_ABSTENTION=0.50
# Reformulation par Ollama (optionnelle, désactivée par défaut)
OLLAMA_ACTIVE=false
OLLAMA_URL=http://localhost:11434
